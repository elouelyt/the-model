# Environment variables
.env

# Local data (raw and processed — regenerated by running the pipeline)
data/raw/
data/processed/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# GCP credentials (exclude service account JSON files)
*.json
# Exception: committed model artifacts are not credentials
!models/*.json
# Exception: Stake odds cache (populated locally with VPN, read by GitHub Actions)
!data/stake_cache.json
# Exception: ATP rankings cache (populated locally weekly, read by GitHub Actions)
!data/rankings_cache.json
# Exception: daily predictions and track record (written by GitHub Actions)
!data/track_record.json
!data/manual_odds.json
!data/ufc_fighters_cache.json
!data/ufc_fights_history.json
!data/ufc_model.json
!data/predictions/
!data/predictions/*.json

# nuevas_ideas: local-only paper-test data
nuevas_ideas/ideas/*/history/
nuevas_ideas/ideas/*/candidates/
nuevas_ideas/data/
nuevas_ideas/RESULTADOS.md
nuevas_ideas/resultados.json
nuevas_ideas/**/__pycache__/
nuevas_ideas/archive/
# nfl: local-only raw data
nfl/data/
data/results.json
